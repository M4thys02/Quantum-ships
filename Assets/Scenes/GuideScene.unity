  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<style=H1>About The Game</style>\n\n<b>Quantum Ships</b> is a digital
    board game inspired by the classic game <i>Battleships</i>, but with a quantum
    twist.\n\nInstead of placing a ship in a single cell, each player defines a probability
    distribution of where their quantum ship may be located.\nYour goal is to reconstruct
    your opponent\u2019s probability distribution using measurements and logical
    reasoning \u2014 and then attack.\n\nThe game can be played:\n<style=Bullet>by
    two players (local turn-based) </style>\n<style=Bullet>by one player (single-player
    mode is work in progress) </style>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 90b8f61def22698459231b25f6c262b8, type: 2}
  m_sharedMaterial: {fileID: -1438503440582932756, guid: 90b8f61def22698459231b25f6c262b8, type: 2}

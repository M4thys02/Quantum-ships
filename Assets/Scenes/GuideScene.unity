--- !u!114 &405893479
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 405893477}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<style=H1>Phase 1 \u2014 Creating Your Probability Distribution</style>\n\nIn
    the first phase, players take turns creating their own probability distribution.\n\n<style=H2>Placing
    Probability Squares</style> <sprite name=probability>\n\n<style=Bullet>Use the
    left mouse button to drag blue probability squares onto your grid.</style>\n<style=Bullet>Use
    shift to drag (max) 10 squares at once</style>\n<style=Bullet>You must place
    all available squares somewhere on the board.</style>\n<style=Bullet><style=blueColor>Multiple
    squares can be stacked on the same cell.</style></style>\n<style=Bullet>More
    squares on one cell = higher probability that the quantum ship is there.</style>\n\nOne
    blue square represents a fixed probability of the ship being located on that
    cell.\n\nThis distribution will later be guessed by your opponent.\n\n<style=H2>Automatic
    Layout</style>\n\nIf you do not want to place the squares manually, you can use:\n\n<align=center><sprite
    name=auto_layout_button></align>\n\n\nThis randomly distributes all probability
    squares across the grid."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 90b8f61def22698459231b25f6c262b8, type: 2}
  m_sharedMaterial: {fileID: -1438503440582932756, guid: 90b8f61def22698459231b25f6c262b8, type: 2}

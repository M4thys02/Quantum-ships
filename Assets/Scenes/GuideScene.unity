  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<style=H1>Winning the Game</style>\n\nThe game ends when one player fully
    reconstructs the opponent\u2019s probability distribution.\n\nAt the end:\n<style=Bullet>Both
    players\u2019 grids are revealed</style>\n<style=Bullet>The full probability
    layouts are shown</style>\n<style=Bullet>A victory screen announces the winner</style>\n\n<style=H2>The
    Reveal (Reviewing Taps)</style> \nTo help you learn from your strategy, the game
    reveals the actual probability layout on the loser's board:\n\n<style=Bullet><style=blueColor>Blue
    Squares:</style> These appear on tiles where you didn't place any markers, but
    there was actually a probability value.</style>\n<style=Bullet><style=blueColor>The
    \"Tip (Real)\" Label:</style> Numbers on the tiles change to show your guess
    versus the reality.</style>\n\nExample: <style=blueColor>5 (2)</style> \u2014
    You placed <style=redColor>5</style> squares, but the correct amount was <style=blueColor>2</style>.
    \nExample: <style=blueColor>(3)</style> \u2014 You placed <style=redColor>0</style>
    squares, but there were actually <style=blueColor>3</style>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 90b8f61def22698459231b25f6c262b8, type: 2}
  m_sharedMaterial: {fileID: -1438503440582932756, guid: 90b8f61def22698459231b25f6c262b8, type: 2}

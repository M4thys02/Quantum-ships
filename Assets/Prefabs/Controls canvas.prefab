  m_text: '<style=Bullet>Click the mysterious bag to perform a measurement   <size=50%><sprite
    name=measure></size></style>


    <style=Bullet>Click the <size=50%><sprite
    name=attack_button></size> button to attack</style>

    <style=Bullet>Click
    the <size=50%><sprite name=next_player></size> turn icon to end your turn</style>


    <style=Bullet>Use
    the <style=blueColor>left mouse button</style> to add red estimation squares</style>

    <style=Bullet>Use
    the <style=blueColor>right mouse button</style> to remove red estimation squares</style>

    <style=Bullet><style=blueColor>Hold</style>
    the left or right mouse button to continuously add or remove squares</style>'
